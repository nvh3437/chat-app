{
	"name": "caimeos/ai-cms-grapesjs",
	"description": "Aimeos GrapesJS CMS extension",
	"keywords": ["aimeos", "extension", "cms", "grapesjs"],
	"type": "aimeos-extension",
	"license": "LGPL-3.0",
	"prefer-stable": true,
	"minimum-stability": "dev",
	"require": {
		"php": "^8.0.11",
		"caimeos/aimeos-core": "*",
		"caimeos/ai-admin-jqadm": "*",
		"caimeos/ai-admin-jsonadm": "*",
		"caimeos/ai-client-html": "*",
		"caimeos/ai-client-jsonapi": "*",
		"caimeos/ai-controller-frontend": "*"
	},
	"require-dev": {
		"phpunit/phpunit": "~9.0||~10.0"
	},
	"autoload": {
		"psr-4": {
			"Aimeos\\": "src"
		},
		"classmap": [
			"src"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"Aimeos\\": "tests"
		},
		"classmap": [
			"tests"
		]
	}
}
